# Local-only application. Bind the server to 127.0.0.1.
DATA_SOFT_DB_PATH=.data/data-soft.sqlite
# Optional live AI. Secrets stay on the server. No AI requests without all fields.
AI_GATEWAY_API_KEY=
AI_MODEL=
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
AI_MONTHLY_BUDGET_USD=25

# Local business discovery uses Census place centers and bounded OSM queries.
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
RESEARCH_USER_AGENT=DataSoftLocalResearch/0.2 (+https://github.com/SkySaikat/data-soft)
OSM_DAILY_QUERY_LIMIT=20
# Optional search for businesses whose directory record has no website.
# The API plan must explicitly allow storing the results used in your CRM.
BRAVE_SEARCH_API_KEY=
SEARCH_STORAGE_RIGHTS_CONFIRMED=false
SEARCH_MONTHLY_REQUEST_LIMIT=100

# Outbound mail: use an SMTP provider permitting your intended outreach.
# Secrets stay on the server. STARTTLS or implicit TLS is always required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
AGENCY_NAME=
AGENCY_POSTAL_ADDRESS=
EMAIL_DAILY_LIMIT=20
EMAIL_CHANNEL_APPROVED=false
EMAIL_REPLY_MONITORING_CONFIRMED=false
EMAIL_AUTHENTICATION_CONFIRMED=false
